NEXT_PUBLIC_SITE_URL=https://enktel.tv
# Powers the AI chat assistant (src/app/api/chat/route.ts) — get a key at
# https://console.anthropic.com. Without it, the assistant option is hidden.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
TMDB_API_KEY=your_tmdb_api_key_here
RESELLER_API_KEY=your_reseller_api_key_here
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_SECRET=your_paypal_secret_here
# Set to "sandbox" for testing, remove or set to "live" for production
PAYPAL_MODE=sandbox
# Full international format, no + or spaces, e.g. 385911234567
NEXT_PUBLIC_WHATSAPP_NUMBER=385911234567
