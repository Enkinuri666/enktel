NEXT_PUBLIC_SITE_URL=https://enktel.tv
# Powers the AI chat assistant (src/app/api/chat/route.ts) — get a key at
# https://openrouter.ai/keys. Without it, the assistant shows a fallback message.
OPENROUTER_API_KEY=your_openrouter_api_key_here
TMDB_API_KEY=your_tmdb_api_key_here
RESELLER_API_KEY=your_reseller_api_key_here
# Guards /api/admin/lines, which can delete a line on the panel. Unset means
# the route is closed, not open — there is no development bypass. Generate one
# with: openssl rand -base64 32
ADMIN_API_KEY=your_admin_api_key_here
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_SECRET=your_paypal_secret_here
# Set to "sandbox" for testing, remove or set to "live" for production
PAYPAL_MODE=sandbox
# Full international format, no + or spaces, e.g. 385911234567
NEXT_PUBLIC_WHATSAPP_NUMBER=385911234567

# ── Catalog export (scripts/export-xtream-catalog.mjs) ──────────────────────
# A line on the panel whose VOD catalog you want to enumerate. Used only by the
# maintenance script — the web app never reads these. The exported files embed
# these credentials in every stream URL, which is why data/catalog/ is
# gitignored.
XTREAM_SERVER=http://line.enktel.online
XTREAM_USERNAME=your_line_username_here
XTREAM_PASSWORD=your_line_password_here
