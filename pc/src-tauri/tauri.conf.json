{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EnkTel IPTV",
  "version": "1.0.0",
  "identifier": "tv.enktel.pc",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EnkTel IPTV",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "shadow": true,
        "center": true,
        "titleBarStyle": "Overlay",
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "EnkTel IPTV",
    "shortDescription": "Premium Windows IPTV client from EnkTel",
    "longDescription": "The desktop bigger brother to the EnkTel IPTV mobile and Android TV apps. Xtream Codes + M3U, EPG, catch-up, DVR, live sports, voice commands and more — built for Windows 11 power users.",
    "category": "Entertainment",
    "copyright": "© 2026 EnkTel IPTV",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
