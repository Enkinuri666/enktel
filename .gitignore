# Next.js
.next/
out/
build/

# Dependencies
node_modules/

# Env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# MCP config (contains API keys)
.mcp.json

# Exported panel catalogs — every Xtream stream URL embeds the line's username
# and password, so these files are credentials. Never commit them.
data/catalog/

# Misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Android (androidtv/)
androidtv/.gradle/
androidtv/build/
androidtv/app/build/
androidtv/local.properties
androidtv/.idea/
*.apk
*.aab

# Signing secrets - never commit real keystores or credentials
*.jks
*.keystore
key.properties
enktel-release.jks

# Gradle wrapper distribution cache (wrapper jar/properties/scripts ARE committed)
androidtv/.gradle/wrapper/dists/
androidtv/.kotlin/

# Python bytecode from the docs scripts.
__pycache__/
*.pyc
