<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- TV build: Leanback banner, DPAD-first, landscape-locked, appears in the Fire TV launcher. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Needed so BootReceiver can trigger auto-launch after the TV finishes booting. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        No tools:replace on android:banner.

        It was there to win a merge conflict that does not exist: src/main
        declares no banner, and neither does any library manifest, so the
        merger had nothing to replace and said so on every build. The banner
        itself is unaffected — a flavour manifest contributing an attribute
        nobody else sets is an ordinary merge, not an override.
    -->
    <application
        android:banner="@drawable/tv_banner">

        <!--
            tools:ignore rationale:
              DiscouragedApi   — the fixed landscape lock is the point of this
                                 flavor. A TV or Fire Stick has no other
                                 orientation, and letting the activity rotate
                                 only ever produced a rotated UI on the handful
                                 of Android TV boxes that report a sensor.
                                 The mobile flavor is unlocked.
              UnusedAttribute  — supportsPictureInPicture needs API 24 and
                                 minSdk is 21. Older platforms ignore unknown
                                 manifest attributes, and PictureInPicture.kt
                                 gates every call behind a version check, so
                                 declaring it costs nothing on API 21-23.
        -->
        <!--
            windowSoftInputMode: without it the default is stateUnspecified,
            and the system's decision when a window contains a text input is
            routinely to raise the IME as the activity appears. On a first run
            that put the soft keyboard on top of the still-playing welcome
            video. stateAlwaysHidden is the TV-correct choice: the IME on a
            television is a full-screen takeover driven by a D-pad, so it
            should only ever appear because the user asked for it.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:supportsPictureInPicture="true"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            tools:ignore="DiscouragedApi,UnusedAttribute">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!--
                Deep links, and specifically the ones Fire OS hands off to.

                Amazon's catalog integration is not a push API the app calls:
                you submit a feed of your VOD to Amazon, and every entry in it
                carries a URI that Fire OS fires at the app when a row on the
                launcher is selected or when someone holds the Alexa button and
                says "play X on EnkTel". Without a filter to catch that URI the
                whole integration has nowhere to land — the catalog would
                resolve, and launching would do nothing.

                Two schemes on purpose. enktel:// is what the catalog feed and
                Alexa use, and it cannot be hijacked by a browser. The https
                form lets a link on enktel.tv open the app directly on a device
                that has it, and fall back to the website on one that doesn't.
            -->
            <!-- No autoVerify here: App Links verification is an http(s)
                 mechanism, and declaring it on a custom scheme is both
                 meaningless and a lint error. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="enktel" android:host="play" />
            </intent-filter>
            <!-- autoVerify needs /.well-known/assetlinks.json served from
                 enktel.tv listing this package and its signing certificate.
                 Until that file exists the link still works — Android just
                 shows a disambiguation dialog instead of opening us directly. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="enktel.tv" android:pathPrefix="/play" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".boot.BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
