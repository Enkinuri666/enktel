<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive launcher icon (API 26+).

    The legacy PNG is full-bleed square art, so every masked launcher either
    clipped the wolf's ears or dropped the whole thing onto a stock white
    squircle. Here the brand near-black is the background layer and the emblem
    is inset into the 72dp safe zone, which survives every mask shape the
    launcher can apply — circle, squircle, rounded square, teardrop.

    mipmap-*/ic_launcher.png stays as the pre-26 fallback.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/enktel_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
