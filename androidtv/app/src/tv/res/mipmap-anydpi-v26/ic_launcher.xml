<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive launcher icon (API 26+) — v1.84 "Aurora" identity.

    The EnkTel wolf logo is kept exactly as it was; what's new is the plate
    behind it — the brand spectrum gradient (azure → indigo → magenta) in place
    of the old flat near-black. Background is a vector gradient, foreground is
    the inset wolf, so the icon is crisp at every launcher density.

    mipmap-*/ic_launcher.png stays as the pre-26 raster fallback.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_gradient" />
    <foreground android:drawable="@drawable/ic_launcher_logo_inset" />
</adaptive-icon>
