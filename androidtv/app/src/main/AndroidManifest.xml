<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      Held only while "Send to PC" is sharing, so the PC client's "who's there"
      broadcast is actually delivered. Wi-Fi hardware drops packets that are not
      addressed to this device unless something asks it not to, which is exactly
      what a subnet broadcast is. Without it discovery silently finds nothing on
      a good half of devices and the viewer is back to typing an IP address.
    -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!--
      Declared explicitly, and not required. A Wi-Fi permission implies
      `android.hardware.wifi` as a *required* feature unless this says
      otherwise, and a great many Android TV boxes are Ethernet-only — which
      would have made the app unavailable to them over a permission held for
      one optional LAN feature. Send to PC works perfectly well over Ethernet;
      the multicast lock simply has nothing to lock.
    -->
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Starts a scheduled recording at its time with the app closed. An exact
         alarm is one of the few things Android 12+ lets start a foreground
         service from the background, and recording is one. Granted at install
         on Android 12 and 13; from 14 the viewer turns it on under Special app
         access > Alarms & reminders, and the Recordings screen offers the way
         there. SCHEDULE_ and not USE_EXACT_ALARM: the latter needs no consent
         and is reserved for alarm clocks and calendars, which this is not. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Voice commands use the on-device SpeechRecognizer service. On Android 11+
         we have to declare it or SpeechRecognizer.isRecognitionAvailable() returns
         false even when a recognition service is installed. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!--
            Package visibility for the IMDb link on a title's details page.

            From API 30 an app cannot see which activities handle an intent
            unless it declares the intent here first, so resolveActivity()
            answers null even on a device that does have a browser and the
            button would never appear. The details screen asks before it
            offers: a sideloaded TV stick often has neither the IMDb app nor a
            browser, and a button that fires an intent into a void is the exact
            fault the trailer button used to have.
        -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="imdb" />
        </intent>
    </queries>

    <application
        android:name=".EnktelApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name_flavor"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Enktel"
        tools:targetApi="34">

        <service
            android:name=".dvr.RecordingService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Where a scheduled recording's alarm lands. Not exported: the alarm
             is addressed to it by name, and the one broadcast it listens for
             comes from the system, which a non-exported receiver still hears. -->
        <receiver
            android:name=".dvr.RecordingAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Holds the process up while the parallel downloader works. Without
             it, leaving the app lets Android freeze the process and the
             download stops. -->
        <service
            android:name=".data.download.DownloadKeepAlive"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Holds the LAN file server up while it is sharing. Same reason: the
             transfer is to another machine and takes minutes, which is longer
             than the viewer will sit on one screen. -->
        <service
            android:name=".data.share.LanShareService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
