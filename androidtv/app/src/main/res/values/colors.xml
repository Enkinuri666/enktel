<?xml version="1.0" encoding="utf-8"?>
<!--
  Native-side colours. These are NOT the app's palette — the UI is Jetpack
  Compose and themes live in ui/theme/Theme.kt, where they can be switched at
  runtime from Settings.

  What these are for is the window before Compose has drawn its first frame:
  the cold-start window background. If it doesn't match the Compose surface
  that lands on top, the app opens with a visible flash of the wrong colour.
  So these track the *default* palette (EnkTel Neon), not any one theme.
-->
<resources>
    <!-- Indigo-black — keep in sync with PaletteAurora.bg (the v1.84 default).
         Near-black with a faint indigo cast so the cold-start window matches
         the first Compose frame of the new flagship theme rather than flashing
         a colder black under it. -->
    <color name="enktel_background">#060814</color>
    <!-- Primary Brand Accent — PaletteAurora.primary (electric periwinkle). -->
    <color name="enktel_blue">#5E8BFF</color>
    <!-- Secondary Brand Accent — PaletteAurora.secondary (violet, the gradient's far stop). -->
    <color name="enktel_purple">#C56BFF</color>
</resources>
