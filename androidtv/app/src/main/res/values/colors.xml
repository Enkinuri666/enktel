<?xml version="1.0" encoding="utf-8"?>
<!--
  Native-side colours. These are NOT the app's palette — the UI is Jetpack
  Compose and themes live in ui/theme/Theme.kt, where they can be switched at
  runtime from Settings.

  What these are for is the window before Compose has drawn its first frame:
  the cold-start window background. If it doesn't match the Compose surface
  that lands on top, the app opens with a visible flash of the wrong colour.
  So these track the *default* palette (EnkTel Neon), not any one theme.
-->
<resources>
    <!-- True black — keep in sync with PaletteEnktelNeon.bg. On OLED this is
         the pixel switched off, so the cold-start window is genuinely dark
         rather than a dark grey that flashes when Compose paints over it. -->
    <color name="enktel_background">#000000</color>
    <!-- Primary Brand Accent — PaletteEnktelNeon.primary. -->
    <color name="enktel_blue">#29B6FF</color>
    <!-- Secondary Brand Accent — PaletteEnktelNeon.secondary. -->
    <color name="enktel_purple">#B14DFF</color>
</resources>
