<?xml version="1.0" encoding="utf-8"?>
<!--
  Native-side colours. These are NOT the app's palette — the UI is Jetpack
  Compose and themes live in ui/theme/Theme.kt, where they can be switched at
  runtime from Settings.

  What these are for is the window before Compose has drawn its first frame:
  the cold-start window background. If it doesn't match the Compose surface
  that lands on top, the app opens with a visible flash of the wrong colour.
  So these track the *default* palette (Deep Space), not any one theme.
-->
<resources>
    <!-- Deep Space Surface Level 0 — keep in sync with PaletteDeepSpace.bg. -->
    <color name="enktel_background">#0B0E14</color>
    <!-- Primary Brand Accent, Electric Cyan — PaletteDeepSpace.primary. -->
    <color name="enktel_blue">#00F0FF</color>
    <!-- Secondary Brand Accent, Deep Violet — PaletteDeepSpace.secondary. -->
    <color name="enktel_purple">#7B2CBF</color>
</resources>
