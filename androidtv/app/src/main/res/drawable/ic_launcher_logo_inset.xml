<?xml version="1.0" encoding="utf-8"?>
<!--
    The EnkTel wolf logo, sitting on @drawable/ic_launcher_gradient. The logo
    art already carries ~22% of its own transparent margin (visible content is
    ~55% of the layer, comfortably inside the adaptive safe zone), so only a
    hair of extra inset is added — enough to guarantee no mask clips it, little
    enough that the wolf reads large and stands out against the plate. The logo
    itself is unchanged; only the plate behind it is the new v1.84 brand
    gradient, with a centre vignette seating the mark.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_launcher_logo"
    android:inset="3%" />
